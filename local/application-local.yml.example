# 本地开发私密配置模板
# 复制本文件为 local/application-local.yml 并填入真实值；
# local/ 已被 .gitignore 排除，真实配置严禁提交。

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/forever
    username: postgres
    password: <数据库密码>

blog:
  admin:
    username: admin
    # 仅在 sys_user 表为空时用于初始化管理员
    password: <管理员初始密码>

# 注意：文件存储（上传的头像/动态媒体，写 S3 兼容对象存储 RustFS）、
# 评论策略（限流间隔/先审后显/邮件通知/收件人）与站点地址等运行参数，
# 均在启动后登录后台「站点设置」在线调整（存 sys_site_config 表，立即生效、重启不丢），
# 调用 PUT /api/admin/settings；yml 不承载运行参数。
