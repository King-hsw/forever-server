# 本地开发私密配置模板
# 复制本文件为 local/application-local.yml 并填入真实值；
# local/ 已被 .gitignore 排除，真实配置严禁提交。

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/forever
    username: postgres
    password: <数据库密码>

blog:
  admin:
    username: admin
    # 仅在 sys_user 表为空时用于初始化管理员
    password: <管理员初始密码>
  # 文件存储：本地起 RustFS 试用（docker run 命令见 README「文件存储」节），
  # 桶 forever 需自行在控制台 http://localhost:9001 创建并设为公开读
  storage:
    endpoint: http://localhost:9000
    access-key: rustfsadmin
    secret-key: rustfsadmin
    bucket: forever

# 注意：评论策略（限流间隔/先审后显/邮件通知/收件人）与站点地址等运行参数，
# 在启动后登录后台「站点设置」在线调整（存 sys_site_config 表，立即生效、重启不丢），
# 调用 PUT /api/admin/settings；yml 不承载运行参数。
