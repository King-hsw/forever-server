# 本地开发环境变量模板
# 用法：cp .env.example .env 并填入真实值，然后 set -a; source .env; set +a; mvn spring-boot:run
# .env 已被 .gitignore 排除，真实值严禁提交；测试/生产用同一套变量名（见 application.yml）

# 数据库（base yml 默认 localhost:5432/forever、postgres/mysecretpassword，不同才需覆盖）
#SPRING_DATASOURCE_URL=
#SPRING_DATASOURCE_USERNAME=
#SPRING_DATASOURCE_PASSWORD=

# 初始管理员（仅 sys_user 表为空时用于建号；BLOG_ADMIN_PASSWORD 必填）
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=<管理员初始密码>

# 文件存储（本地 RustFS，起法见 README「文件存储」节；桶需自建并设公开读）
BLOG_STORAGE_ENDPOINT=http://localhost:9000
BLOG_STORAGE_ACCESS_KEY=rustfsadmin
BLOG_STORAGE_SECRET_KEY=rustfsadmin
BLOG_STORAGE_BUCKET=forever
#BLOG_STORAGE_PUBLIC_BASE_URL=
#BLOG_STORAGE_PRESIGN_TTL=15m

# Web Push VAPID（三项任一缺失 = 推送功能关闭；生成：npx web-push generate-vapid-keys）
#PUSH_VAPID_PUBLIC_KEY=
#PUSH_VAPID_PRIVATE_KEY=
#PUSH_VAPID_SUBJECT=

# 高德 Web Service key（动态页「获取当前位置」逆地理；留空 = 功能关闭）
#BLOG_MOMENTS_AMAP_KEY=
