<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forever.server.tag.TagMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (name)
        VALUES (#{name})
    </insert>

    <update id="update">
        UPDATE tag
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE
        FROM tag
        WHERE id = #{id}
    </delete>

    <delete id="deleteRelationsByTagId">
        DELETE
        FROM article_tag
        WHERE tag_id = #{tagId}
    </delete>

    <select id="findById" resultType="com.forever.server.tag.Tag">
        SELECT *
        FROM tag
        WHERE id = #{id}
    </select>

    <select id="countByName" resultType="long">
        SELECT COUNT(*)
        FROM tag
        WHERE name = #{name}
    </select>

    <!-- 全部标签 + 已发布文章数 -->
    <select id="listWithPublishedCount" resultType="com.forever.server.tag.TagMapper$TagCountRow">
        SELECT t.id, t.name, COUNT(a.id) AS article_count
        FROM tag t
                 LEFT JOIN article_tag at_ ON at_.tag_id = t.id
                 LEFT JOIN article a ON a.id = at_.article_id AND a.status = 'PUBLISHED' AND a.deleted = false
        GROUP BY t.id
        ORDER BY t.id
    </select>
</mapper>
